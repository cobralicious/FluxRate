# FluxRate environment template
# Copy this file to .env and fill in the values you need for local development.
# DO NOT commit a real key or any secret values.

# Required for CoinGecko catalog/market data.
# Type: server-side only
# Required: optional for local development, recommended for CoinGecko features
# Used in: app/api/market/route.ts and lib/providers.ts
# Expected value: your CoinGecko Demo API key, e.g. "cg_demo_..."
COINGECKO_DEMO_API_KEY=

# Optional: local runtime override for Cloudflare-style development.
# Type: server-side only
# Required: optional
# Used in: local tooling around Wrangler/Vite
# Expected value: a Cloudflare-compatible worker environment name or blank for local defaults
# CLOUDFLARE_ENV=

# Optional: public base URL for browser-facing configuration.
# Type: public (browser-visible)
# Required: optional
# Used in: deployment metadata or future service links
# Expected value: full HTTPS URL, e.g. "https://fluxrate.example.com"
# NEXT_PUBLIC_APP_URL=
